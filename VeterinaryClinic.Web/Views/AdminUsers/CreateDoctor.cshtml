@model VeterinaryClinic.Web.ViewModels.AdminUsers.CreateDoctorViewModel

@{
    ViewData["Title"] = "Добавяне на лекар";
}

<h1>Добавяне на лекар</h1>

<p class="text-muted">
    Създай профил на лекар. Той ще зададе паролата си чрез защитена покана.
</p>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="AdminUsers"
              asp-action="CreateDoctor"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="UserName"
                       class="form-label"></label>

                <input asp-for="UserName"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="UserName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label"></label>

                <input asp-for="Email"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Създай профил на лекар
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}