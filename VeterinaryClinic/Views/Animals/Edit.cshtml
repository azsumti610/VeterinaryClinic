@model VeterinaryClinic.Models.Animal

@{
    ViewData["Title"] = "Редактиране на животно";
}

<h1>Редактиране на животно</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="AnimalId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    Име
                </label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="AnimalTypeId" class="form-label">
                    Вид животно
                </label>
                <select id="AnimalTypeId"
                        asp-items="ViewBag.AnimalTypeId"
                        class="form-select"
                        required>
                    <option value="">-- Избери животно --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="BreedId" class="form-label">
                    Порода
                </label>
                <select asp-for="BreedId"
                        asp-items="ViewBag.BreedId"
                        class="form-select">
                    <option value="">Изберете порода</option>
                </select>
                <span asp-validation-for="BreedId"
                      class="text-danger"></span>
            </div>

            @if (User.IsInRole("Doctor"))
            {
                <div class="mb-3">
                    <label asp-for="OwnerId" class="form-label">
                        Собственик
                    </label>
                    <select asp-for="OwnerId"
                            asp-items="ViewBag.OwnerId"
                            class="form-select">
                        <option value="">Изберете собственик</option>
                    </select>
                    <span asp-validation-for="OwnerId"
                          class="text-danger"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="OwnerId" />
            }

            <div class="mb-3">
                <label asp-for="BirthDate" class="form-label">
                    Дата на раждане
                </label>
                <input asp-for="BirthDate"
                       type="date"
                       class="form-control" 
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="BirthDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Описание
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <div class="mb-3">
                    <label class="form-label">
                        Текуща снимка
                    </label>

                    <div>
                        <img src="@Model.ImagePath"
                             alt="Снимка на животното"
                             style="max-width:250px;
                        max-height:200px;
                        object-fit:cover;"
                             class="img-thumbnail" />
                    </div>

                    <div class="form-check mt-2">
                        <input type="checkbox"
                               name="removeImage"
                               id="removeImage"
                               value="true"
                               class="form-check-input" />
                        <label for="removeImage"
                               class="form-check-label">
                            Премахни текущата снимка
                        </label>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label">
                    Избери нова снимка
                </label>
                <input asp-for="ImageFile"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control" />
                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>
                <small class="text-muted">
                    JPG, PNG или WEBP, максимум 5 MB.
                    Ако не изберете нова снимка,
                    старата ще се запази.
                </small>
            </div>

            <button type="submit" class="btn btn-primary">
                Запази промените
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Назад
            </a>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeSelect =
                document.getElementById("AnimalTypeId");

            const breedSelect =
                document.getElementById("BreedId");

            const breeds = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                            ViewData["BreedsByType"]
                            )
                            );

            const selectedBreedId = breedSelect.value;

            const currentBreed = breeds.find(breed =>
                String(breed.BreedId) === selectedBreedId
            );

            if (currentBreed) {
                typeSelect.value =
                    String(currentBreed.AnimalTypeId);
            }

            function updateBreeds(keepSelection = false) {
                const typeId = Number(typeSelect.value);

                breedSelect.innerHTML = "";

                const placeholder =
                    document.createElement("option");

                placeholder.value = "";
                placeholder.textContent =
                    "-- Избери порода --";

                breedSelect.appendChild(placeholder);

                breeds
                    .filter(breed =>
                        breed.AnimalTypeId === typeId
                    )
                    .forEach(breed => {
                        const option =
                            document.createElement("option");

                        option.value = breed.BreedId;
                        option.textContent = breed.Name;

                        if (keepSelection &&
                            String(breed.BreedId) ===
                            selectedBreedId) {
                            option.selected = true;
                        }

                        breedSelect.appendChild(option);
                    });

                breedSelect.disabled = !typeSelect.value;
            }

            typeSelect.addEventListener("change", function () {
                updateBreeds();
            });

            updateBreeds(true);
        });
    </script>
}

