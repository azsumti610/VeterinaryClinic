@model VeterinaryClinic.Models.Animal

@{
    ViewData["Title"] = "Детайли за животно";
}

<h1>Детайли за животно</h1>

<p>Информация за регистрираното животно.</p>

<hr />

<div class="row">
    <div class="col-md-8">

        <dl class="row">

            <dt class="col-sm-4">Име</dt>
            <dd class="col-sm-8">
                @Model.Name
            </dd>

            <dt class="col-sm-4">Порода</dt>
            <dd class="col-sm-8">
                @(Model.Breed?.Name ?? "Няма информация")
            </dd>

            <dt class="col-sm-4">Собственик</dt>
            <dd class="col-sm-8">
                @if (Model.Owner != null)
                {
                    @($"{Model.Owner.FirstName} {Model.Owner.LastName}")
                }
                else
                {
                    <span>Няма информация</span>
                }
            </dd>

            <dt class="col-sm-4">Дата на раждане</dt>
            <dd class="col-sm-8">
                @(Model.BirthDate?.ToString("dd.MM.yyyy") ?? "Няма информация")
            </dd>

            <dt class="col-sm-4">Описание</dt>
            <dd class="col-sm-8">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Няма описание"
                    : Model.Description)
            </dd>

            <dt class="col-sm-4">Снимка</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <img src="@Url.Content("~" + Model.ImagePath)"
                         alt="Снимка на @Model.Name"
                         class="img-fluid rounded border"
                         style="max-width: 300px; max-height: 250px; object-fit: contain;" />
                }
                else
                {
                    <span>Няма качена снимка</span>
                }
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.AnimalId"
           class="btn btn-primary">
            Редактирай
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Назад към животните
        </a>

    </div>
</div>
