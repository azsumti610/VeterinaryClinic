@model VeterinaryClinic.Models.Animal

@{
    ViewData["Title"] = "Добавяне на животно";
}

<h1>Добави животно</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Име</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BreedId" class="control-label">Порода</label>
                <select asp-for="BreedId" class="form-control" asp-items="ViewBag.BreedId">
                    <option value="">-- Избери порода --</option>
                </select>
                <span asp-validation-for="BreedId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OwnerId" class="control-label">Собственик</label>
                <select asp-for="OwnerId" class="form-control" asp-items="ViewBag.OwnerId">
                    <option value="">-- Избери собственик --</option>
                </select>
                <span asp-validation-for="OwnerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BirthDate" class="control-label">Дата на раждане</label>
                <input asp-for="BirthDate" type="date" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Описание</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImagePath" class="control-label">Път до снимката</label>
                <input asp-for="ImagePath" class="form-control" />
                <span asp-validation-for="ImagePath" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Създай</button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Назад към списъка</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}