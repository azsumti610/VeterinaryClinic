@model IEnumerable<VeterinaryClinic.Models.AnimalType>

@{
    ViewData["Title"] = "Видове животни";
}

<h1>Видове животни</h1>

<p>
    Списък с видовете животни, поддържани
    от ветеринарната клиника.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Вид животно</th>
            <th>Описание</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.Description ?? "Няма описание")</td>
            </tr>
        }
    </tbody>
</table>
