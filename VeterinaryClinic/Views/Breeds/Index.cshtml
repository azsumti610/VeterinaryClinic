@model IEnumerable<VeterinaryClinic.Models.Breed>

@{
    ViewData["Title"] = "Породи";
}

<h1>Породи</h1>

<p>
    Списък с породите животни, поддържани
    от ветеринарната клиника.
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Порода</th>
            <th>Описание</th>
            <th>Вид животно</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
                
                <td>@item.Name</td>
                <td>@(item.Description ?? "Няма описание")</td>
                <td>@item.AnimalType?.Name</td>
                    <td>
                    <a asp-action="Edit"
                       asp-route-breedid="@item.BreedId"
                       class="btn btn-outline-primary btn-sm">
                        Редактирай описание
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
