@model IEnumerable<VeterinaryClinic.Models.Examination>

@{
    ViewData["Title"] = "Прегледи";
}

<h1>Прегледи</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добави преглед</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Животно</th>
            <th>Лекар</th>
            <th>Дата</th>
            <th>Час</th>
            <th>Описание</th>
            <th>Диагноза</th>
            <th>Препоръки</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Animal?.Name</td>
                <td>@(item.Doctor?.FullName ?? item.Doctor?.Email)</td>
                <td>@item.ExamDate.ToString("dd.MM.yyyy")</td>
                <td>@item.ExamTime.ToString("HH:mm")</td>
                <td>@item.Description</td>
                <td>@item.Diagnosis</td>
                <td>@item.Recommendations</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExaminationId">Редактирай</a> |
                    <a asp-action="Details" asp-route-id="@item.ExaminationId">Детайли</a> |
                    <a asp-action="Delete" asp-route-id="@item.ExaminationId">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>