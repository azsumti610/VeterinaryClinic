@model VeterinaryClinic.Models.Examination

@{
    ViewData["Title"] = "Изтриване на преглед";
}

<h1>Изтриване на преглед</h1>

<div class="alert alert-warning">
    <strong>Внимание!</strong>
    Сигурни ли сте, че искате да изтриете този преглед?
    Това действие не може да бъде отменено.
</div>

<hr />

<div class="row">
    <div class="col-md-8">

        <dl class="row">

            <dt class="col-sm-4">Животно</dt>
            <dd class="col-sm-8">
                @(Model.Animal?.Name ?? "Няма информация")
            </dd>

            <dt class="col-sm-4">Ветеринарен лекар</dt>
            <dd class="col-sm-8">
                @(Model.Doctor?.FullName
                    ?? Model.Doctor?.Email
                    ?? "Няма информация")
            </dd>

            <dt class="col-sm-4">Дата на прегледа</dt>
            <dd class="col-sm-8">
                @Model.ExamDate.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-4">Час на прегледа</dt>
            <dd class="col-sm-8">
                @Model.ExamTime
            </dd>

            <dt class="col-sm-4">Описание</dt>
            <dd class="col-sm-8">
                @(Model.Description ?? "Няма описание")
            </dd>

            <dt class="col-sm-4">Диагноза</dt>
            <dd class="col-sm-8">
                @(Model.Diagnosis ?? "Няма диагноза")
            </dd>

            <dt class="col-sm-4">Препоръки</dt>
            <dd class="col-sm-8">
                @(Model.Recommendations ?? "Няма препоръки")
            </dd>

        </dl>

        <form asp-action="Delete"
              asp-route-id="@Model.ExaminationId"
              method="post">

            <input type="hidden"
                   asp-for="ExaminationId" />

            <button type="submit"
                    class="btn btn-danger">
                Изтрий прегледа
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Отказ
            </a>

        </form>

    </div>
</div>
