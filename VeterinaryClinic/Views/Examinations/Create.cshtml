@model VeterinaryClinic.Models.Examination

@{
    ViewData["Title"] = "Добавяне на преглед";
}

<h1>Добави преглед</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="AnimalId" class="control-label">Животно</label>
                <select asp-for="AnimalId" class="form-control" asp-items="ViewBag.AnimalId">
                    <option value="">-- Избери животно --</option>
                </select>
                <span asp-validation-for="AnimalId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DoctorId" class="control-label">Лекар</label>
                <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId">
                    <option value="">-- Избери лекар --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ExamDate" class="control-label">Дата</label>
                <input asp-for="ExamDate" type="date" class="form-control" />
                <span asp-validation-for="ExamDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ExamTime" class="control-label">Час</label>
                <input asp-for="ExamTime" type="time" class="form-control" />
                <span asp-validation-for="ExamTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Описание</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Diagnosis" class="control-label">Диагноза</label>
                <textarea asp-for="Diagnosis" class="form-control"></textarea>
                <span asp-validation-for="Diagnosis" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Recommendations" class="control-label">Препоръки</label>
                <textarea asp-for="Recommendations" class="form-control"></textarea>
                <span asp-validation-for="Recommendations" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Запази прегледа</button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Назад към списъка</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}