@model VeterinaryClinic.Models.Examination

@{
    ViewData["Title"] = "Добавяне на преглед";
}

<h1>Добавяне на преглед</h1>

<p>Въведете информация за нов ветеринарен преглед.</p>

<hr />

<div class="row">
    <div class="col-md-8">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="AnimalId" class="form-label">
                    Животно
                </label>

                <select asp-for="AnimalId"
                        asp-items="ViewBag.AnimalId"
                        class="form-select">
                    <option value="">-- Избери животно --</option>
                </select>

                <span asp-validation-for="AnimalId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorId" class="form-label">
                    Ветеринарен лекар
                </label>

                <select asp-for="DoctorId"
                        asp-items="ViewBag.DoctorId"
                        class="form-select">
                    <option value="">-- Избери лекар --</option>
                </select>

                <span asp-validation-for="DoctorId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExamDate" class="form-label">
                    Дата на прегледа
                </label>

                <input asp-for="ExamDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ExamDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExamTime" class="form-label">
                    Час на прегледа
                </label>

                <input asp-for="ExamTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="ExamTime"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    Описание
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Diagnosis" class="form-label">
                    Диагноза
                </label>

                <textarea asp-for="Diagnosis"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Diagnosis"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Recommendations" class="form-label">
                    Препоръки
                </label>

                <textarea asp-for="Recommendations"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Recommendations"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Запази прегледа
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Назад към прегледите
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
